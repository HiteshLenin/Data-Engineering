#1. List all customers along with the films they have rented.

with customer_rentals As(
       select r.customer_id, f.film_id, f.title
       from rental r
       join inventory i on i.inventory_id = r.inventory_id
	   join film f on i.film_id = f.film_id
		)
select c.customer_id, c.first_name, c.last_name, cr.film_id, cr.title
from customer c
left join customer_rentals cr  on cr.customer_id = c.customer_id
order by c.customer_id, cr.title;

